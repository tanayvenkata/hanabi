# LLM Configuration for Hanabi AI Agents
# Copy this file to .env and fill in your values

# ============================================================================
# LLM Provider Selection
# ============================================================================
# Options: "local" or "openai"
# - "local": Use LM Studio or other local LLM server
# - "openai": Use OpenAI API
LLM_PROVIDER=local

# ============================================================================
# Local LLM Configuration (for LM Studio, vLLM, etc.)
# ============================================================================
# URL of your local LLM server
# Default: LM Studio default endpoint
LLM_URL=http://127.0.0.1:1234/v1/chat/completions

# ============================================================================
# OpenAI API Configuration
# ============================================================================
# Your OpenAI API key (required if LLM_PROVIDER=openai)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: OpenAI Organization ID
# Only needed if you belong to multiple organizations
# OPENAI_ORG_ID=your-org-id-here

# ============================================================================
# Model Configuration
# ============================================================================
# Model name to use
# For local: depends on what you have loaded in LM Studio
# For OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo, etc.
# If not set, defaults to:
#   - "gpt-4o-mini" for OpenAI
#   - "nvidia/nemotron-3-nano" for local
# LLM_MODEL=gpt-4o-mini

# ============================================================================
# Generation Parameters
# ============================================================================
# Temperature for sampling (0.0 = deterministic, 1.0 = very random)
# Default: 0.3
LLM_TEMPERATURE=0.3

# ============================================================================
# Usage Examples
# ============================================================================
#
# Example 1: Using OpenAI GPT-4o-mini
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...your-key-here
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.3
#
# Example 2: Using local LM Studio
# LLM_PROVIDER=local
# LLM_URL=http://127.0.0.1:1234/v1/chat/completions
# LLM_MODEL=nvidia/nemotron-3-nano
# LLM_TEMPERATURE=0.3
#
# Example 3: Using a remote vLLM server
# LLM_PROVIDER=local
# LLM_URL=http://your-server:8000/v1/chat/completions
# LLM_MODEL=meta-llama/Llama-2-7b-chat-hf
# LLM_TEMPERATURE=0.3
